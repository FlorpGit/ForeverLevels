{
  "name": "pathwise",
  "version": "0.3.0-dev",
  "private": true,
  "description": "Pathwise: a leveling and profession companion for World of Warcraft: Forever",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "lua5.1 tests/run.lua",
    "validate": "lua5.1 tools/validate_routes.lua",
    "lint": "luacheck Pathwise Pathwise_Gear Pathwise_Bags examples && luacheck tests tools",
    "media": "node tools/media.js",
    "recipes": "node tools/data/recipes.js",
    "data": "lua5.1 tools/data/build.lua",
    "routes": "lua5.1 tools/port/polestar.lua ../pathwise/addon/Pathwise_Guides/Guides.lua Pathwise/Routes",
    "link": "node tools/link.js",
    "pack": "node tools/pack.js",
    "set-version": "node tools/version.js"
  }
}
